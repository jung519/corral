# Working notes and planning documents. Kept locally, not published: they record the
# state of a moment, and a moment-old document in a public repo reads as the project's
# current state to anyone — or anything — that finds it.
docs/
# No trailing slash: `node_modules/` matches directories only, so a symlink named
# node_modules slips past it — which is how one got committed once.
node_modules
dist/
release/
coverage/
*.log
.env
.env.*
!.env.example
.DS_Store
.corral-state/
corral.yaml
corral.local.yaml
tmp/
